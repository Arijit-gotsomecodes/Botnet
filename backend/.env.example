# Copy this file to .env and fill in your values.
# The backend reads these at startup.

# ── S3 Integration ────────────────────────────────────────────────────────────
# Both S3 buckets are PUBLIC — no AWS credentials required.
# Set USE_S3=true to download model artifacts and dataset from S3 on startup.
#   Models  → s3://cloud-soc-ml-artifacts-269223836366/models/
#   Dataset → s3://cloud-soc-dataset-269223836366/dev_scale/
USE_S3=true
AWS_REGION=us-east-1
