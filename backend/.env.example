# Copy this file to .env and fill in your values.
# The backend reads these at startup.

# ── S3 Integration ────────────────────────────────────────────────────────────
# Set USE_S3=true to have the backend download model artifacts and dataset
# files from S3 on startup. Bucket names are hardcoded in s3_loader.py.
#   Models  → s3://cloud-soc-ml-artifacts-269223836366/models/
#   Dataset → s3://cloud-soc-dataset-269223836366/dev_scale/
USE_S3=true
AWS_REGION=us-east-1

# Leave blank if using ~/.aws/credentials or an IAM role
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
